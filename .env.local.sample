# Your WordPress site URL
# In Codespaces, questo viene generato automaticamente da setup-env.sh
# In locale, usa: http://localhost:3001
NEXT_PUBLIC_WORDPRESS_URL=https://faustexample.wpengine.com

# Plugin secret found in WordPress Settings->Headless
# Copia questo valore da WordPress Admin -> Settings -> Faust
# FAUST_SECRET_KEY=YOUR_PLUGIN_SECRET

# The URL of your site, used by Faust for sitemap generation
# In Codespaces, questo viene generato automaticamente da setup-env.sh
# In locale, usa: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
