{
  "name": "WordPress + Faust.js",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace/codespaces-wordpress-faust",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js (Faust)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8080": {
      "label": "WordPress",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "bash .devcontainer/update-wp-url.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GraphQL.vscode-graphql",
        "wpspec.wordpress-docs"
      ]
    }
  }
}
